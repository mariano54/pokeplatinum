    'map_data_658.json',
    'map_data_659.json',
    'map_data_660.json',
    'map_data_661.json',
    'map_data_662.json',
    'map_data_663.json',
    'map_data_664.json',
    'map_data_665.json'
)

map_data_narc = custom_target('land_data.narc',
    output: [
        'land_data.narc',
    ],
    input: map_data_bin_gen.process(map_data_srcs),
    command: [
        nitroarc_exe,
        '--create',
        '--files-from', files('map_data.order'),
        '--file', '@OUTPUT0@',
        '@PRIVATE_DIR@',
    ],
)

nitrofs_files += map_data_narc

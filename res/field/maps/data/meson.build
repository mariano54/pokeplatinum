# Each map is a JSON file (tile collision/behaviors, map props, BDHC height plates)
# plus the NSBMD terrain model it names, found in ../models. See docs/maps/editing_maps.md.
map_data_bin_gen = generator(
    map_data_py,
    arguments: [
        '@INPUT@',
        '@OUTPUT@',
        '--depfile', '@DEPFILE@',
        '--models-dir', meson.current_source_dir() / '..' / 'models',
        '--tile-behaviors', meson.project_source_root() / 'include' / 'constants' / 'field' / 'map_tile_behaviors.h',
        '--map-prop-model-naix', map_prop_model_narc[1].full_path(),
    ],
    output: '@BASENAME@.bin',
    depfile: '@BASENAME@.bin.d',
    depends: [ map_prop_model_narc[1] ],
)

map_data_srcs = files(

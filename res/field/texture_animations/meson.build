# Animated map textures (water, flowers, lamps...): data/fldtanime.narc, see
# tools/jsoncnv/texture_animations.py and src/overlay005/texture_resource_manager.c.
texture_animation_textures = files(
    'textures/asahamabe.nsbtx',
    'textures/asasea.nsbtx',
    'textures/azt_wall02.1.nsbtx',
    'textures/bf_hata02.1.nsbtx',
    'textures/bf_lakep.1.nsbtx',
    'textures/c1_lamp01.nsbtx',
    'textures/c1_lamp02.nsbtx',
    'textures/c3_s03b.1.nsbtx',
    'textures/dun16_wall.1.nsbtx',
    'textures/dun_sea.nsbtx',
    'textures/gingaanm.1.nsbtx',
    'textures/gym04_fl_p.1.nsbtx',
    'textures/gym04_fl_r.1.nsbtx',
    'textures/hamabe.nsbtx',
    'textures/lakep.1.nsbtx',
    'textures/lost_kebe.nsbtx',
    'textures/m_4ten_hi.1.nsbtx',
    'textures/m_bf05_hsr1.1.nsbtx',
    'textures/m_bf05_light03.nsbtx',
    'textures/mc_gamen.1.nsbtx',
    'textures/numa_b.nsbtx',
    'textures/numa_b2.nsbtx',
    'textures/numa_c.nsbtx',
    'textures/numa_c2.nsbtx',
    'textures/numa_d.nsbtx',
    'textures/numa_d2.nsbtx',
    'textures/numa_e.nsbtx',
    'textures/numa_e2.nsbtx',
    'textures/numa_f1b.nsbtx',
    'textures/numa_f1c.nsbtx',
    'textures/numa_f1de.nsbtx',
    'textures/pikao.1.nsbtx',
    'textures/pikar.1.nsbtx',
    'textures/pikay.1.nsbtx',
    'textures/rhana.nsbtx',
    'textures/sea.nsbtx',
    'textures/searock.nsbtx',
    'textures/t3_fl_b.1.nsbtx',
    'textures/t3_fl_p.1.nsbtx',
    'textures/t3_fl_r.1.nsbtx',
    'textures/t3_fl_y.1.nsbtx',
    'textures/warp00.1.nsbtx',
    'textures/wtk_kabe1.nsbtx',
    'textures/wtk_kabe11.0.nsbtx',
    'textures/wtk_kabe12.0.nsbtx',
    'textures/wtk_kabe13.0.nsbtx',
    'textures/wtk_kabe2.nsbtx',
    'textures/wtk_kabe3.nsbtx',
    'textures/yomawaru.1.nsbtx',
    'textures/yuka_ora.1.nsbtx',
    'textures/yuka_red.1.nsbtx',
    'textures/yuka_yellow.1.nsbtx'
)

nitrofs_files += custom_target('fldtanime.narc',
    output: 'fldtanime.narc',
    input: files('texture_animations.json'),
    depend_files: texture_animation_textures,
    command: [
        texture_animations_py, 'narc', '@INPUT@', '@OUTPUT@',
        '--textures-dir', meson.current_source_dir() / 'textures',
    ],
)

# Diamond/Pearl's version of the same data, left unused in Platinum.
nitrofs_files += custom_target('fld_anime',
    output: [
        'fld_anime0.bin',
        'fld_anime1.bin',
        'fld_anime2.bin',
        'fld_anime3.bin',
        'fld_anime4.bin',
        'fld_anime5.bin',
        'fld_anime6.bin',
        'fld_anime7.bin',
        'fld_anime8.bin',
        'fld_anime9.bin',
        'fld_anime10.bin'
    ],
    input: files('legacy_texture_animations.json'),
    command: [ texture_animations_py, 'legacy', '@INPUT@', '@OUTDIR@' ],
)

+#ifdef GDBSTUB_ENABLED
+// "monitor fps <n>": limit emulation to n frames per second, or 0 for unlimited.
+// "monitor savestate <path>" / "monitor loadstate <path>": run once the current frame ends,
+// and the reply (OK or E.<message>) is sent once the state is written/loaded.
+int EmuInstance::gdbCommand(const std::string& cmd)
+{
+    size_t space = cmd.find(' ');
+    std::string name = cmd.substr(0, space);
+    std::string arg = (space == std::string::npos) ? "" : cmd.substr(space + 1);
+
+    if (name == "fps")
+    {
+        char* end;
+        double fps = strtod(arg.c_str(), &end);
+        if (arg.empty() || *end || !(fps >= 0)) return 1;
+
+        doLimitFPS = fps > 0;
+        if (doLimitFPS) targetFPS = fps;
+        return 0;
+    }
+    if ((name == "savestate" || name == "loadstate") && !arg.empty())
+    {
+        gdbStateCmd = cmd;
+        return Gdb::RemoteCmdDeferred;
+    }
+    return 1;
+}
+
+void EmuInstance::gdbFinishCommand()
+{
+    if (gdbStateCmd.empty()) return;
+
+    std::string cmd;
+    std::swap(cmd, gdbStateCmd);
+    std::string path = cmd.substr(cmd.find(' ') + 1);
+
+    const char* reply = "OK";
+    if (cmd[0] == 's')
+    {
+        if (!saveState(path)) reply = "E.savestate failed";
+    }
+    else if (!Platform::FileExists(path)) reply = "E.state file not found";
+    else if (!loadState(path)) reply = "E.loadstate failed";
+
+    nds->ARM9.GdbFinishRemoteCmd(reply);
+}
+#endif
